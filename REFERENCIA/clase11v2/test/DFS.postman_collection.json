				{
					"name": "Registro user",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"const requestBody = JSON.parse(pm.request.body.raw);",
									"",
									"const responseBody = pm.response.json();",
									" ",
									"",
									" pm.test(\"La respuesta contiene un token\", () => {",
									"    pm.expect(responseBody).to.have.property(\"token\");",
									"    pm.expect(responseBody.token).to.be.a(\"string\");",
									"});",
									"",
									"const response = pm.response.json();",
									"pm.collectionVariables.set(\"access_token\", response.token);",
									" ",
									"pm.collectionVariables.set(",
									"    \"loginUsername\",",
									"    responseBody.user.username",
									");",
									"",
									"pm.collectionVariables.set(",
									"    \"loginPassword\",",
									"    requestBody.password",
									");",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const numero = Math.floor(Math.random() * 100000);",
									"const username = `usuario${numero}`;",
									"pm.collectionVariables.set(\"username\", username);",
									"",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
